<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ══════════════════════════════════════ -->
            <!-- HERO HEADER CARD -->
            <!-- ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_compare">

                    <!-- Large watermark logo -->
                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="-40dp"
                        android:layout_marginBottom="-40dp"
                        android:alpha="0.12"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_tuition_logo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <!-- Tag badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_rounded_primary"
                            android:backgroundTint="#5C6BC0"
                            android:letterSpacing="0.08"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="5dp"
                            android:text="SIDE-BY-SIDE ANALYSIS"
                            android:textColor="#EAEAEA"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:lineSpacingExtra="-2dp"
                            android:text="Compare\nUniversities"
                            android:textColor="@android:color/white"
                            android:textSize="30sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:alpha="0.85"
                            android:text="See exactly how much you'll save by picking one university over another."
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp" />

                        <!-- Quick stats row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="20+"
                                    android:textColor="@android:color/white"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Universities"
                                    android:textColor="@android:color/white"
                                    android:alpha="0.7"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="৳600"
                                    android:textColor="@android:color/white"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Lowest /credit"
                                    android:textColor="@android:color/white"
                                    android:alpha="0.7"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="৳8,250"
                                    android:textColor="@android:color/white"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Highest /credit"
                                    android:textColor="@android:color/white"
                                    android:alpha="0.7"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════ -->
            <!-- INPUT SECTION -->
            <!-- ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:cardCornerRadius="28dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Section label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PARAMETERS"
                        android:textSize="11sp"
                        android:letterSpacing="0.12"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="18dp" />

                    <!-- Credits & Scholarship Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Credits (e.g. 130)"
                            android:layout_marginEnd="8dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeColor="?attr/colorOutlineVariant"
                            app:boxBackgroundColor="?attr/colorSurfaceContainerLow">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTotalCredits"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Scholarship %"
                            android:layout_marginStart="8dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxStrokeWidth="1dp"
                            app:boxStrokeColor="?attr/colorOutlineVariant"
                            app:boxBackgroundColor="?attr/colorSurfaceContainerLow">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etScholarship"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Department Selector -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="?attr/colorOutlineVariant">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📚 Department / Program"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:layout_marginBottom="8dp" />

                            <Spinner
                                android:id="@+id/spinnerDepartment"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:backgroundTint="?attr/colorPrimary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- University selectors with VS badge -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- University A selector -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="20dp"
                                app:cardCornerRadius="16dp"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="?attr/colorOutlineVariant">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🏛 University A"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:textColor="?attr/colorPrimary"
                                        android:layout_marginBottom="8dp" />

                                    <Spinner
                                        android:id="@+id/spinnerUniA"
                                        android:layout_width="match_parent"
                                        android:layout_height="40dp"
                                        android:backgroundTint="?attr/colorPrimary" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- University B selector -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                app:cardCornerRadius="16dp"
                                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                                app:cardElevation="0dp"
                                app:strokeWidth="1dp"
                                app:strokeColor="?attr/colorOutlineVariant">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🏛 University B"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:textColor="?attr/colorTertiary"
                                        android:layout_marginBottom="8dp" />

                                    <Spinner
                                        android:id="@+id/spinnerUniB"
                                        android:layout_width="match_parent"
                                        android:layout_height="40dp"
                                        android:backgroundTint="?attr/colorTertiary" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Floating VS badge -->
                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_indigo"
                            android:gravity="center"
                            android:text="VS"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:elevation="6dp" />
                    </FrameLayout>

                    <!-- Compare Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCompare"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_gradient_button"
                        android:elevation="4dp"
                        android:text="⚡ Compare Now"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════ -->
            <!-- HOW IT WORKS SECTION -->
            <!-- ══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="?attr/colorTertiaryContainer"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOW IT WORKS"
                        android:textSize="11sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        android:layout_marginBottom="16dp" />

                    <!-- Step 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_primary_fixed"
                            android:backgroundTint="?attr/colorOnTertiaryContainer"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="?attr/colorTertiaryContainer"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginEnd="14dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Enter total credits for your degree program"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>

                    <!-- Step 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_primary_fixed"
                            android:backgroundTint="?attr/colorOnTertiaryContainer"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="?attr/colorTertiaryContainer"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginEnd="14dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Pick two universities to compare side-by-side"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>

                    <!-- Step 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_primary_fixed"
                            android:backgroundTint="?attr/colorOnTertiaryContainer"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="?attr/colorTertiaryContainer"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginEnd="14dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Get an instant fee breakdown with savings insight"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══════════════════════════════════════ -->
            <!-- RESULTS SECTION  -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/resultsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Results header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="24dp"
                        android:background="?attr/colorPrimary"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comparison Results"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- Results Uni A -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_gradient_result_a">

                        <!-- Faint watermark -->
                        <ImageView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="-20dp"
                            android:layout_marginEnd="-20dp"
                            android:alpha="0.08"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tvResUniA"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Uni A"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#1a237e"
                                android:layout_marginBottom="10dp" />

                            <TextView
                                android:id="@+id/tvBreakdownA"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="#283593"
                                android:lineSpacingExtra="6dp" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Results Uni B -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_gradient_result_b">

                        <!-- Faint watermark -->
                        <ImageView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="-20dp"
                            android:layout_marginEnd="-20dp"
                            android:alpha="0.08"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tvResUniB"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Uni B"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#880E4F"
                                android:layout_marginBottom="10dp" />

                            <TextView
                                android:id="@+id/tvBreakdownB"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="#AD1457"
                                android:lineSpacingExtra="6dp" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
