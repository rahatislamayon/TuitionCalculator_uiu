<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- AUTH FRAGMENTS                                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.tuitioncalculator.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
            
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/signupFragment" />
            
        <action
            android:id="@+id/action_login_to_forgotPassword"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.tuitioncalculator.SignupFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_signup">
        
        <action
            android:id="@+id/action_signup_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
            
        <action
            android:id="@+id/action_signup_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.tuitioncalculator.ForgotPasswordFragment"
        android:label="Forgot Password"
        tools:layout="@layout/fragment_forgot_password">
        
        <action
            android:id="@+id/action_forgotPassword_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- HOME FRAGMENT                                      -->
    <!-- ═══════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.tuitioncalculator.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_home_to_universities"
            app:destination="@id/universitiesFragment"
            app:enterAnim="@anim/nav_fade_in"
            app:exitAnim="@anim/nav_fade_out"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />

        <action
            android:id="@+id/action_home_to_compare"
            app:destination="@id/compareFragment"
            app:enterAnim="@anim/nav_fade_in"
            app:exitAnim="@anim/nav_fade_out"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />

        <action
            android:id="@+id/action_home_to_calculator"
            app:destination="@id/calculatorFragment"
            app:enterAnim="@anim/nav_fade_in"
            app:exitAnim="@anim/nav_fade_out"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />

        <action
            android:id="@+id/action_home_to_payments"
            app:destination="@id/paymentsFragment"
            app:enterAnim="@anim/nav_fade_in"
            app:exitAnim="@anim/nav_fade_out"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />
    </fragment>
        
    <!-- ═══════════════════════════════════════════════════ -->
    <!-- CALCULATOR FRAGMENT                                -->
    <!-- ═══════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/calculatorFragment"
        android:name="com.example.tuitioncalculator.CalculatorFragment"
        android:label="Calculator"
        tools:layout="@layout/fragment_calculator">

        <action
            android:id="@+id/action_calculator_to_payments"
            app:destination="@id/paymentsFragment"
            app:enterAnim="@anim/nav_fade_in"
            app:exitAnim="@anim/nav_fade_out"
            app:popEnterAnim="@anim/nav_pop_enter"
            app:popExitAnim="@anim/nav_pop_exit" />
    </fragment>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PAYMENTS FRAGMENT                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/paymentsFragment"
        android:name="com.example.tuitioncalculator.PaymentsFragment"
        android:label="Payments"
        tools:layout="@layout/fragment_payments" />

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- PROFILE FRAGMENT                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.tuitioncalculator.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- UNIVERSITIES FRAGMENT                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/universitiesFragment"
        android:name="com.example.tuitioncalculator.UniversitiesFragment"
        android:label="Universities"
        tools:layout="@layout/fragment_universities" />

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- COMPARE FRAGMENT                                   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <fragment
        android:id="@+id/compareFragment"
        android:name="com.example.tuitioncalculator.CompareFragment"
        android:label="Compare"
        tools:layout="@layout/fragment_compare" />
</navigation>
