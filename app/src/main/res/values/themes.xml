<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.TuitionCalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        <item name="colorTertiaryContainer">@color/tertiary_fixed</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_fixed</item>

        <!-- Missing Material3 attributes used in layouts -->
        <item name="colorSecondary">#3f51b5</item>
        <item name="colorOnSecondary">#ffffff</item>
        <item name="colorSecondaryContainer">#e8eaf6</item>
        <item name="colorOnSecondaryContainer">#1a237e</item>
        <item name="colorTertiary">#7b1fa2</item>
        <item name="colorOnTertiary">#ffffff</item>
        <item name="colorPrimaryFixed">@color/primary_container</item>
        <item name="colorOnPrimaryFixed">@color/on_primary_container</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.TuitionCalculator.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.TuitionCalculator.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.TuitionCalculator.Large</item>
    </style>

    <style name="Theme.TuitionCalculator" parent="Base.Theme.TuitionCalculator" />

    <style name="ShapeAppearance.TuitionCalculator.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.TuitionCalculator.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.TuitionCalculator.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Bottom Navigation Polished Styles -->
    <style name="Widget.TuitionCalc.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.TuitionCalc.NavIndicator</item>
    </style>

    <style name="ShapeAppearance.TuitionCalc.NavIndicator" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.TuitionCalc.CircleLogo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.TuitionCalc.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.TuitionCalc.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>